---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Projects" description="Explore the product areas and project categories GoreeWorks builds across software, digital products, physical products, publishing, and creative media.">
  <section class="page-hero">
    <div class="site-shell">
      <span class="kicker">Projects</span>
      <h1 class="mo-type-display mo-type-balanced">Built across mediums.</h1>
      <p class="mo-type-body mo-type-pretty">GoreeWorks is structured to create across software, digital products, physical products, publishing resources, and creative media.</p>
    </div>
  </section>

  <section class="section section-rule">
    <div class="site-shell grid-3">
      <article class="mo-card feature-card"><span class="index">01</span><div><h2 class="mo-type-heading">Software + applications</h2><p class="mo-type-body">Websites, applications, automation, and internal tools designed around useful outcomes.</p></div></article>
      <article class="mo-card feature-card"><span class="index">02</span><div><h2 class="mo-type-heading">Digital products</h2><p class="mo-type-body">Products and experiences delivered through the web, commerce, and connected digital systems.</p></div></article>
      <article class="mo-card feature-card"><span class="index">03</span><div><h2 class="mo-type-heading">Physical products</h2><p class="mo-type-body">Tangible products that extend GoreeWorks beyond screens and software.</p></div></article>
      <article class="mo-card feature-card"><span class="index">04</span><div><h2 class="mo-type-heading">Publishing</h2><p class="mo-type-body">Resources that package knowledge, ideas, and creative work for practical use.</p></div></article>
      <article class="mo-card feature-card"><span class="index">05</span><div><h2 class="mo-type-heading">Creative media</h2><p class="mo-type-body">Visual and digital media created as part of a broader product and brand ecosystem.</p></div></article>
      <article class="mo-card feature-card"><span class="index">06</span><div><h2 class="mo-type-heading">Internal systems</h2><p class="mo-type-body">Customer, commerce, infrastructure, and operational tools built for greater control and independence.</p></div></article>
    </div>
  </section>

  <section class="section section-compact">
    <div class="site-shell mo-card callout" data-mo-elevation="1">
      <span class="kicker">Portfolio</span>
      <h2 class="mo-type-large-title mo-type-balanced">Public project releases will appear here as they are ready.</h2>
      <p class="mo-type-body mo-type-pretty">The site is being built as the public home for GoreeWorks. Project pages will be added as individual products and initiatives are prepared for public release.</p>
    </div>
  </section>
</BaseLayout>
