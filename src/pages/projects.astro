---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Projects" description="Explore the product areas and project categories GoreeWorks builds across software, digital products, physical products, publishing, and creative media.">
  <section class="page-hero">
    <div class="site-shell">
      <span class="eyebrow">Projects</span>
      <h1 class="display" style="margin-top:1rem">Built across mediums.</h1>
      <p class="lede">GoreeWorks is structured to create across software, digital products, physical products, publishing resources, and creative media.</p>
    </div>
  </section>

  <section class="section section-rule">
    <div class="site-shell grid-3">
      <article class="card"><span class="index">01</span><h3>Software + applications</h3><p>Websites, applications, automation, and internal tools designed around useful outcomes.</p></article>
      <article class="card"><span class="index">02</span><h3>Digital products</h3><p>Products and experiences delivered through the web, commerce, and connected digital systems.</p></article>
      <article class="card"><span class="index">03</span><h3>Physical products</h3><p>Tangible products that extend GoreeWorks beyond screens and software.</p></article>
      <article class="card"><span class="index">04</span><h3>Publishing</h3><p>Resources that package knowledge, ideas, and creative work for practical use.</p></article>
      <article class="card"><span class="index">05</span><h3>Creative media</h3><p>Visual and digital media created as part of a broader product and brand ecosystem.</p></article>
      <article class="card"><span class="index">06</span><h3>Internal systems</h3><p>Customer, commerce, infrastructure, and operational tools built for greater control and independence.</p></article>
    </div>
  </section>

  <section class="section compact">
    <div class="site-shell callout">
      <span class="eyebrow">Portfolio</span>
      <h2 class="heading" style="margin-top:1rem">Public project releases will appear here as they are ready.</h2>
      <p class="lede" style="margin:1.25rem 0 0">The site is being built as the public home for GoreeWorks. Project pages will be added as individual products and initiatives are prepared for public release.</p>
    </div>
  </section>
</BaseLayout>
