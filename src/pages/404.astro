---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not Found" description="The requested GoreeWorks page could not be found.">
  <section class="page-hero">
    <div class="site-shell">
      <span class="eyebrow">404</span>
      <h1 class="display" style="margin-top:1rem">Page not found.</h1>
      <p class="lede">The page you requested does not exist or may have moved.</p>
      <div class="hero-actions" style="margin-top:2rem">
        <a class="button primary" href="/">Return home</a>
        <a class="button" href="/projects">Explore projects</a>
      </div>
    </div>
  </section>
</BaseLayout>
