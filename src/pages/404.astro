---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not Found" description="The requested GoreeWorks page could not be found.">
  <section class="page-hero">
    <div class="site-shell">
      <span class="kicker">404</span>
      <h1 class="mo-type-display mo-type-balanced">Page not found.</h1>
      <p class="mo-type-body">The page you requested does not exist or may have moved.</p>
      <div class="hero-actions">
        <a class="mo-button" data-mo-variant="primary" href="/">Return home</a>
        <a class="mo-button" data-mo-variant="ghost" href="/projects">Explore projects</a>
      </div>
    </div>
  </section>
</BaseLayout>
