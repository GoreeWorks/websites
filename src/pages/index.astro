---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <section class="hero">
    <div class="site-shell hero-copy">
      <span class="kicker">Creative technology + product</span>
      <h1 class="mo-type-display mo-type-balanced">Ideas become products here.</h1>
      <p class="mo-type-body mo-type-pretty">GoreeWorks builds, designs, and delivers useful products, software, experiences, and ideas—with intention from concept to execution.</p>
      <div class="hero-actions">
        <a class="mo-button" data-mo-variant="primary" href="/projects">Explore what we build</a>
        <a class="mo-button" data-mo-variant="ghost" href="/about">About GoreeWorks</a>
      </div>
      <div class="hero-meta" aria-label="Areas of focus">
        <span>Products</span><span>Software</span><span>Design</span><span>Commerce</span><span>Publishing</span>
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="site-shell">
      <p class="statement">Built around a simple mission: create things that are <em>useful</em>, meaningful, and thoughtfully designed.</p>
    </div>
  </section>

  <section class="section section-rule">
    <div class="site-shell">
      <div class="section-heading grid-2">
        <div>
          <span class="kicker">What we make</span>
          <h2 class="mo-type-large-title mo-type-balanced">One company. Many forms of creation.</h2>
        </div>
        <p class="mo-type-body mo-type-pretty">GoreeWorks spans software, digital products, physical products, publishing resources, and creative media. The common thread is thoughtful creation backed by practical technology.</p>
      </div>
      <div class="grid-4">
        <article class="mo-card feature-card"><span class="index">01</span><div><h3 class="mo-type-heading">Software</h3><p class="mo-type-body">Applications, websites, internal tools, and digital systems built to solve real problems.</p></div></article>
        <article class="mo-card feature-card"><span class="index">02</span><div><h3 class="mo-type-heading">Products</h3><p class="mo-type-body">Digital and physical products shaped by usefulness, clarity, and intentional design.</p></div></article>
        <article class="mo-card feature-card"><span class="index">03</span><div><h3 class="mo-type-heading">Commerce</h3><p class="mo-type-body">Customer experiences, ecommerce, and product systems designed as connected experiences.</p></div></article>
        <article class="mo-card feature-card"><span class="index">04</span><div><h3 class="mo-type-heading">Publishing</h3><p class="mo-type-body">Resources and creative media that turn ideas and knowledge into tangible outcomes.</p></div></article>
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="site-shell grid-2">
      <div>
        <span class="kicker">Ownership philosophy</span>
        <h2 class="mo-type-large-title mo-type-balanced">Build more. Own more.</h2>
      </div>
      <div class="prose">
        <p>GoreeWorks aims to build and control more of its own websites, applications, infrastructure, customer systems, commerce systems, and internal tools.</p>
        <p>That ownership creates room for deeper customization, stronger independence, and more possibilities for what comes next.</p>
      </div>
    </div>
  </section>

  <section class="section section-compact">
    <div class="site-shell mo-card callout" data-mo-elevation="1">
      <span class="kicker">The next chapter</span>
      <h2 class="mo-type-large-title mo-type-balanced">Create better things. Build better systems.</h2>
      <p class="mo-type-body mo-type-pretty">GoreeWorks focuses on products, creativity, commerce, software, digital experiences, physical goods, and publishing—working alongside GoreeCloud's focus on privacy, security, infrastructure, identity, and platform technology.</p>
      <div class="hero-actions"><a class="mo-button" data-mo-variant="primary" href="/about">Read the story</a></div>
    </div>
  </section>
</BaseLayout>
