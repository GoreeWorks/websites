---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Contact GoreeWorks about products, projects, collaborations, and company inquiries.">
  <section class="page-hero">
    <div class="site-shell">
      <span class="kicker">Contact</span>
      <h1 class="mo-type-display mo-type-balanced">Start with an idea.</h1>
      <p class="mo-type-body mo-type-pretty">For product, project, collaboration, or general company inquiries, reach GoreeWorks through the official company email.</p>
      <div class="hero-actions">
        <a class="mo-button" data-mo-variant="primary" href="mailto:goreeworks@gmail.com">goreeworks@gmail.com</a>
        <a class="mo-button" data-mo-variant="ghost" href="https://github.com/GoreeWorks" rel="noreferrer">GitHub</a>
      </div>
    </div>
  </section>

  <section class="section section-compact section-rule">
    <div class="site-shell grid-2">
      <div><span class="kicker">What to include</span><h2 class="mo-type-large-title mo-type-balanced">A little context goes a long way.</h2></div>
      <div class="prose"><p>Share what you are trying to create, the problem you want to solve, and any useful context about the product, audience, or timeline.</p></div>
    </div>
  </section>
</BaseLayout>
