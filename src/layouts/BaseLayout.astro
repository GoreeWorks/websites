---
const { title = 'GoreeWorks', description = 'GoreeWorks digital projects and services.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header>
      <nav>
        <a href="/">GoreeWorks</a>
        <a href="/about">About</a>
        <a href="/projects">Projects</a>
        <a href="/services">Services</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>© {new Date().getFullYear()} GoreeWorks</footer>
  </body>
</html>
